    "width": 112,
    "height": 112,
    "znear_m": 0.015722888392066734,
    "zfar_m": 78.6144437175034,
    "frame_convention": "looks along -Z, +Y up (MuJoCo and USD/OpenGL cameras agree)",
    "output": "RGB uint8 HWC",
    "mujoco_lighting": {
      "lights": [
        {
          "directional": true,
          "dir": [
            0.0,
            0.0,
            -1.0
          ],
          "diffuse": [
            0.699999988079071,
            0.699999988079071,
            0.699999988079071
          ],
          "ambient": [
            0.0,
            0.0,
            0.0
          ],
          "specular": [
            0.30000001192092896,
            0.30000001192092896,
            0.30000001192092896
          ],
          "castshadow": true
        }
      ],
      "headlight": {
        "active": true,
        "ambient": [
          0.10000000149011612,
          0.10000000149011612,
          0.10000000149011612
        ],
        "diffuse": [
          0.4000000059604645,
          0.4000000059604645,
          0.4000000059604645
