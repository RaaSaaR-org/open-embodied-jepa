    "reference_arm": "v3 arm B (onboard, patch 14), which E0 re-runs",
    "reference_rollout_excess_m": 0.010577969253063202,
    "required_reduction_m": 0.005277969253063202,
    "rule": "half of the reference arm's rollout excess. Exact half is 0.005288985 m; the threshold is that rounded to two significant figures, 0.2 % looser.",
    "size_against_v3_contrasts": "the required reduction (0.52780 cm) is 1.05x the C-A rollout contrast (0.50484 cm) and 1.54x the D-B one (0.34376 cm), the exact point estimates in TASK-052's paired-bootstrap report and the two contrasts its conservative reading could NOT separate from sampling noise. It is of the same order as them, not comfortably larger. That is a real weakness of this threshold and it is recorded rather than dressed up.",
    "threshold_m": 0.0053,
    "why_not_v2": "v2's 0.39 cm was carried over, not recomputed: the v2 checkpoints have an incompatible implementation hash and this code cannot reproduce that figure",
    "why_not_v3_best": "v3 arm D's 0.83 cm comes from the B<->D patch contrast, which TASK-052's conservative reading could not distinguish from its own sampling noise; a threshold at that value would be passable by noise alone"
  },
  "gate_definitions": {
    "G1": "median palm-apple readout error at h=8 on predicted latents, val moving windows",
    "G2a": "G1 divided by the model's own persistence readout on the same windows",
    "G2b": "G1 divided by the shuffled-action control on the same windows",
    "G3": "median apple-plate error at h=8 over all valid val windows",
    "G4": "median absolute apple-height error at h=8 over the grasp cohort",
    "G5": "AUROC of apple_held at h=8 over the lift cohort",
    "G6a": "pooled within-state Spearman between predicted and true approach cost across the sibling candidate actions of one pre-grasp state, at h=16, over groups whose true costs span at least 5 mm",
    "G6b": "median top-1 regret at h=16: the true approach cost of the candidate the model ranks best, minus the best true cost, over the same groups",
    "G7a": "fraction of ordered sibling pairs at h=16 where the own-action prediction beats the swapped-action one",
    "G7b": "Spearman between predicted and true sibling divergence at h=16",
    "G8a": "collapsed fraction of encoded val latents",
    "G8b": "effective rank of encoded val latents",
    "G8c": "mean per-dimension latent standard deviation",
    "G9": "median rollout excess at h=8 on the val moving windows: G1 minus the readout error of a directly encoded target-frame observation on the identical windows"
  },
